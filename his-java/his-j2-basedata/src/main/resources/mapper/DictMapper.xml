<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.basedata.mapper.DictMapper">
    <select id="selectDictNameList" resultType="java.lang.String">
        SELECT DISTINCT display
        FROM ter_concept
        WHERE is_deleted = 0
    </select>
</mapper>