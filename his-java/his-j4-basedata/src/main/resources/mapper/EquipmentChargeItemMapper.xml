<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.basedata.mapper.EquipmentChargeItemMapper">

    <update id="deleteByEquipmentIds">
        UPDATE adm_charge_item_definition
        SET is_deleted = 1, deleted_at = NOW(), deleted_by = #{userId}
        WHERE instance_id IN
        <foreach collection="equipmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
