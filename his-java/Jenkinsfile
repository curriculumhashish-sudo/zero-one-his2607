pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk'
        PATH      = '/opt/maven/bin:/usr/lib/jvm/java-17-openjdk/bin:/usr/bin:${env.PATH}'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('安装私有依赖') {
            steps {
                dir('his-java') {
                    sh '''
                        # 确保 Jenkins 用户 Maven 仓库目录存在
                        mkdir -p ~/.m2/repository
                        # 解压私有依赖包（父 POM + zeroone 私有 jar）到 Maven 仓库
                        if [ -f star-deps.zip ]; then
                            if command -v unzip >/dev/null 2>&1; then
                                unzip -o star-deps.zip -d ~/.m2/repository
                            else
                                # 没有 unzip 则用 jar 命令解压
                                cp star-deps.zip /tmp/star-deps.zip
                                cd ~/.m2/repository
                                jar xf /tmp/star-deps.zip
                                rm -f /tmp/star-deps.zip
                            fi
                            echo "私有依赖安装完成"
                            # 清理 Maven 之前下载失败生成的 .lastUpdated 缓存文件，避免 Maven 跳过依赖解析
                            find ~/.m2/repository/com/zeroone -name "*.lastUpdated" -type f -delete 2>/dev/null || true
                            ls -la ~/.m2/repository/com/zeroone/star/zero-one-cloud-build/2.0.0-SNAPSHOT/ || true
                        else
                            echo "警告：star-deps.zip 不存在，跳过"
                        fi
                    '''
                }
            }
        }

        stage('Maven 打包') {
            steps {
                dir('his-java') {
                    sh '''
                        # 先安装根 POM 到本地仓库
                        mvn install -N -DskipTests
                        # 再打包目标模块及其依赖
                        mvn clean package -DskipTests \
                            -pl his-j5-ons,his-j5-configuration \
                            -am \
                            -Dmaven.test.skip=true
                    '''
                }
            }
        }

        stage('构建 Docker 镜像') {
            steps {
                dir('his-java') {
                    sh '''
                        docker compose build his-j5-ons his-j5-configuration
                    '''
                }
            }
        }

        stage('部署服务') {
            steps {
                dir('his-java') {
                    sh '''
                        docker compose down
                        docker compose up -d
                        echo "等待服务启动..."
                        sleep 30
                    '''
                }
            }
        }

        stage('健康检查') {
            steps {
                sh '''
                    for i in $(seq 1 12); do
                        if curl -sf http://localhost:10500/actuator/health | grep -q "UP"; then
                            echo "his-j5-ons 健康检查通过"
                            break
                        fi
                        echo "等待 his-j5-ons 启动... ($i/12)"
                        sleep 10
                    done

                    for i in $(seq 1 12); do
                        if curl -sf http://localhost:10501/actuator/health | grep -q "UP"; then
                            echo "his-j5-configuration 健康检查通过"
                            break
                        fi
                        echo "等待 his-j5-configuration 启动... ($i/12)"
                        sleep 10
                    done

                    curl -sf http://localhost:10500/actuator/health || exit 1
                    curl -sf http://localhost:10501/actuator/health || exit 1
                    echo "所有服务健康检查通过"
                '''
            }
        }
    }

    post {
        success {
            echo '部署成功！服务地址：'
            echo "  - his-j5-ons:           http://121.199.54.234:10500"
            echo "  - his-j5-configuration: http://121.199.54.234:10501"
            echo "  - Nacos 控制台:          http://121.199.54.234:8848/nacos"
            echo "  - Jenkins:              http://121.199.54.234:8080"
        }
        failure {
            echo '部署失败！请检查日志：'
            echo '  docker compose logs his-j5-ons'
            echo '  docker compose logs his-j5-configuration'
            echo '  docker compose logs nacos'
        }
    }
}
