pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk'
        PATH      = '/opt/maven/bin:/usr/lib/jvm/java-17-openjdk/bin:/usr/bin:${env.PATH}'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('清理工作区') {
            steps {
                sh '''
                    # 清理可能有权限问题的 git 缓存
                    if [ -d ".git" ]; then
                        chmod -R 755 .git 2>/dev/null || true
                        chown -R $(whoami) .git 2>/dev/null || true
                    fi
                    echo "工作区清理完成"
                '''
            }
        }

        stage('安装私有依赖') {
            steps {
                dir('his-java/star-deps') {
                    sh '''
                        # 安装根父 POM（dependencyManagement 版本管理）
                        mvn install:install-file \
                            -Dfile=zero-one-cloud-build-2.0.0-SNAPSHOT.pom \
                            -DgroupId=com.zeroone.star \
                            -DartifactId=zero-one-cloud-build \
                            -Dversion=2.0.0-SNAPSHOT \
                            -Dpackaging=pom
                        # 安装 zero-one-cloud-starter POM（fastdfs 的父 POM）
                        mvn install:install-file \
                            -Dfile=zero-one-cloud-starter-2.0.0-SNAPSHOT.pom \
                            -DgroupId=com.zeroone.star \
                            -DartifactId=zero-one-cloud-starter \
                            -Dversion=2.0.0-SNAPSHOT \
                            -Dpackaging=pom
                        # 安装 fastdfs-spring-boot-starter jar 及其 pom（his-common 直接依赖）
                        mvn install:install-file \
                            -Dfile=fastdfs-spring-boot-starter-2.0.0-SNAPSHOT.jar \
                            -DpomFile=fastdfs-spring-boot-starter-2.0.0-SNAPSHOT.pom
                        echo "所有私有依赖安装完成"
                    '''
                }
            }
        }

        stage('Maven 打包') {
            steps {
                dir('his-java') {
                    sh '''
                        # 先安装根 POM 到本地仓库
                        mvn install -N -DskipTests
                        # 再打包目标模块及其依赖
                        mvn clean package -DskipTests \
                            -pl his-j5-ons,his-j5-configuration \
                            -am \
                            -Dmaven.test.skip=true
                    '''
                }
            }
        }

        stage('构建 Docker 镜像') {
            steps {
                dir('his-java') {
                    sh '''
                        docker compose build his-j5-ons his-j5-configuration
                    '''
                }
            }
        }

        stage('部署服务') {
            steps {
                dir('his-java') {
                    sh '''
                        docker compose down
                        docker compose up -d
                        echo "等待服务启动..."
                        sleep 30
                    '''
                }
            }
        }

        stage('健康检查') {
            steps {
                sh '''
                    for i in $(seq 1 12); do
                        if curl -sf http://localhost:10500/j5-ons/actuator/health | grep -q "UP"; then
                            echo "his-j5-ons 健康检查通过"
                            break
                        fi
                        echo "等待 his-j5-ons 启动... ($i/12)"
                        sleep 10
                    done

                    for i in $(seq 1 12); do
                        if curl -sf http://localhost:10501/j5-configuration/actuator/health | grep -q "UP"; then
                            echo "his-j5-configuration 健康检查通过"
                            break
                        fi
                        echo "等待 his-j5-configuration 启动... ($i/12)"
                        sleep 10
                    done

                    curl -sf http://localhost:10500/j5-ons/actuator/health || exit 1
                    curl -sf http://localhost:10501/j5-configuration/actuator/health || exit 1
                    echo "所有服务健康检查通过"
                '''
            }
        }
    }

    post {
        success {
            echo '部署成功！服务地址：'
            echo "  - his-j5-ons:           http://121.199.54.234:10500/j5-ons/doc.html"
            echo "  - his-j5-configuration: http://121.199.54.234:10501/j5-configuration/doc.html"
            echo "  - Nacos 控制台:          http://121.199.54.234:8848/nacos"
            echo "  - Jenkins:              http://121.199.54.234:8080"
        }
        failure {
            echo '部署失败！请检查日志：'
            echo '  docker compose logs his-j5-ons'
            echo '  docker compose logs his-j5-configuration'
            echo '  docker compose logs nacos'
        }
    }
}
