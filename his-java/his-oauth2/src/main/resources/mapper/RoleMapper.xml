<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.oauth2.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.zeroone.star.oauth2.entity.Role">
        <id column="id" jdbcType="VARCHAR" property="id" />
        <result column="name" jdbcType="VARCHAR" property="name" />
        <result column="code" jdbcType="VARCHAR" property="code" />
        <result column="description" jdbcType="VARCHAR" property="description" />
    </resultMap>

    <!-- 通过用户ID查询角色 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        select id, `name`, code, description
        from whale_roles
        where id in (
            select role_id
            from whale_user_roles
            where user_id = #{userId}
        )
    </select>

    <!-- 通过菜单路径查询角色：whale_menus.permission_name → whale_permissions.name → whale_permission_grants -->
    <select id="selectByMenuPath" resultMap="BaseResultMap">
        select distinct r.id, r.`name`, r.code, r.description
        from whale_roles r
        where r.id in (
            select distinct pg.provider_key
            from whale_permission_grants pg
            where pg.provider_name = 'R'
              and pg.permission_name in (
                select m.permission_name
                from whale_menus m
                where m.path = #{path}
                  and m.permission_name is not null
            )
        )
    </select>

</mapper>