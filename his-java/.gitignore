# Compiled class file
*.class
*.classpath
*.factorypath

# Log file
*.log
!log/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.7z
*.exe
