<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.j7.pharmacy.mapper.InventoryLockMapper">

    <select id="findByInventoryId" resultType="com.zeroone.star.j7.pharmacy.entity.approval.InventoryLock">
        SELECT * FROM inventory_lock
        WHERE inventory_id = #{inventoryId}
          AND is_deleted = 0
    </select>

    <delete id="deleteByBusNo">
        DELETE FROM inventory_lock WHERE bus_no = #{busNo}
    </delete>

</mapper>
