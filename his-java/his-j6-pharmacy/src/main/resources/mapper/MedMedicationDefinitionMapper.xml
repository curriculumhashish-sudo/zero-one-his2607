<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.pharmacy.mapper.MedMedicationDefinitionMapper">

    <select id="selectIdsByCategoryCodes" resultType="java.lang.Long">
        select id from med_medication_definition where category_code in
        <foreach item="code" index="index" collection="medicationCategoryCodes" open="(" separator="," close=")">
            #{code}
        </foreach>

    </select>
    <select id="selectIdsByKeyword" resultType="java.lang.Long">
        select id from med_medication_definition where name like CONCAT('%', #{keyword}, '%')
    </select>
</mapper>
