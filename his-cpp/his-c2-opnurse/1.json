{
  "openapi": "3.0.3",
  "info": {
    "title": "门诊护士站前端接口",
    "version": "1.0.0",
    "description": "供 Apifox 导入的门诊护士站前端接口契约。患者队列正在按后端 /ons/patient-queue 接口完成适配中；其余接口为当前前端 Mock 对应的目标契约。"
  },
  "servers": [
    {
      "url": "/",
      "description": "使用当前环境的 API 基础地址"
    }
  ],
  "tags": [
    {
      "name": "门诊护士站",
      "description": "患者队列、执行、耗材、打印和执行历史"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ons/patient-queue": {
      "get": {
        "tags": [ "门诊护士站" ],
        "summary": "分页查询患者队列",
        "description": "正在联调接口。前端将患者姓名和单日日期转换为 patient_name、visit_date，并将 snake_case 响应适配为页面模型。",
        "operationId": "pageOutpatientNursePatientQueue",
        "parameters": [
          {
            "name": "department_id",
            "in": "query",
            "description": "科室 ID，可选；当前页面暂未提供筛选控件。",
            "schema": { "type": "string" }
          },
          {
            "name": "doctor_id",
            "in": "query",
            "description": "医生 ID，可选；当前页面暂未提供筛选控件。",
            "schema": { "type": "string" }
          },
          {
            "name": "patient_name",
            "in": "query",
            "description": "患者姓名关键词。",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "就诊状态：0-待就诊，1-就诊中，2-已完成。",
            "schema": {
              "type": "integer",
              "enum": [ 0, 1, 2 ]
            }
          },
          {
            "name": "visit_date",
            "in": "query",
            "description": "就诊日期。",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-08-01"
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": true,
            "description": "页码，从 1 开始。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "description": "每页条数。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PatientQueueResponse" },
                "example": {
                  "code": 10000,
                  "message": "查询成功",
                  "data": {
                    "pageIndex": 1,
                    "pageSize": 100,
                    "total": 1,
                    "pages": 1,
                    "rows": [
                      {
                        "id": "queue-001",
                        "encounter_id": "encounter-001",
                        "patient_id": "patient-001",
                        "patient_name": "林安然",
                        "patient_gender": "女",
                        "patient_age": 32,
                        "patient_card_no": "M20260801001",
                        "department_id": "dept-001",
                        "department_name": "内科门诊",
                        "doctor_id": "doctor-001",
                        "doctor_name": "王医生",
                        "visit_no": "V20260801001",
                        "visit_order": 8,
                        "status": 1,
                        "status_name": "就诊中",
                        "register_time": "2026-08-01 08:35:00",
                        "expected_visit_time": "2026-08-01 09:00:00"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/encounters/{encounterId}/execution-items": {
      "get": {
        "tags": [ "门诊护士站" ],
        "summary": "查询当前就诊执行项目",
        "description": "前端当前由 Mock 提供数据，后端实现时应按本次就诊隔离项目。",
        "operationId": "getOutpatientNurseExecutionItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/EncounterId"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionItemsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/encounters/{encounterId}/consumable-items": {
      "get": {
        "tags": [ "门诊护士站" ],
        "summary": "查询当前就诊耗材项目",
        "description": "前端当前由 Mock 提供数据，返回当前就诊需要展示的耗材及发放状态。",
        "operationId": "getOutpatientNurseConsumableItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/EncounterId"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumableItemsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/executions": {
      "post": {
        "tags": [ "门诊护士站" ],
        "summary": "批量执行护士项目",
        "description": "支持部分成功、幂等提交和乐观锁。执行人及执行时间应由后端根据登录信息生成。",
        "operationId": "performOutpatientNurseExecutions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PerformNurseExecutionsRequest" },
              "example": {
                "encounterId": "encounter-001",
                "items": [
                  {
                    "itemId": "execution-item-001",
                    "version": 0
                  }
                ],
                "idempotencyKey": "ac05497a-226a-4b3f-b2a3-725e3b2ced34"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "执行完成；通过 successItems、failedItems 表示逐项结果。",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionCommandResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "版本冲突",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/executions/cancel": {
      "post": {
        "tags": [ "门诊护士站" ],
        "summary": "取消最近一次执行",
        "description": "取消操作必须保留审计记录，不得物理删除原执行记录。",
        "operationId": "cancelOutpatientNurseExecution",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CancelNurseExecutionRequest" },
              "example": {
                "encounterId": "encounter-001",
                "item": {
                  "itemId": "execution-item-001",
                  "version": 1
                },
                "reason": "登记错误"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "取消完成",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionCommandResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "版本冲突或项目状态不允许取消",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/print/jobs": {
      "post": {
        "tags": [ "门诊护士站" ],
        "summary": "提交护士站打印任务",
        "description": "根据单据类型打印选中的执行项目。当前前端支持七种打印单据。",
        "operationId": "printOutpatientNurseDocuments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NursePrintRequest" },
              "example": {
                "encounterId": "encounter-001",
                "documentIds": [ "execution-item-001" ],
                "documentType": "TREATMENT_SHEET",
                "reprint": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "打印任务提交结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PrintResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/ons/patients/{patientId}/execution-history": {
      "get": {
        "tags": [ "门诊护士站" ],
        "summary": "分页查询患者历史执行记录",
        "description": "跨就诊查询患者执行历史，供右侧执行记录标签页展示；不应从执行项目列表临时推导。",
        "operationId": "pageOutpatientNurseExecutionHistory",
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "description": "患者档案唯一标识。",
            "schema": { "type": "string" }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "执行开始日期。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "执行结束日期。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "执行状态。",
            "schema": { "$ref": "#/components/schemas/NurseExecutionStatus" }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionHistoryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "EncounterId": {
        "name": "encounterId",
        "in": "path",
        "required": true,
        "description": "本次就诊唯一标识。",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或登录状态失效",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServerError": {
        "description": "服务器处理失败",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [ "code", "message" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 9999
          },
          "message": {
            "type": "string",
            "example": "操作失败"
          },
          "data": { "nullable": true }
        }
      },
      "PatientQueueResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": { "$ref": "#/components/schemas/PatientQueuePage" }
        }
      },
      "PatientQueuePage": {
        "type": "object",
        "required": [ "pageIndex", "pageSize", "total", "rows" ],
        "properties": {
          "pageIndex": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OnsPatientQueueItem" }
          }
        }
      },
      "OnsPatientQueueItem": {
        "type": "object",
        "description": "患者队列网络响应模型。当前后端使用 snake_case。encounter_id 推荐返回；缺失时前端暂时以排队记录 id 兼容。",
        "required": [
          "id",
          "patient_id",
          "patient_name",
          "patient_gender",
          "patient_age",
          "patient_card_no",
          "department_name",
          "visit_no",
          "visit_order",
          "status",
          "status_name",
          "register_time"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "排队记录 ID。"
          },
          "encounter_id": {
            "type": "string",
            "description": "本次就诊 ID；后续按就诊查询工作台数据时使用。"
          },
          "patient_id": {
            "type": "string",
            "description": "患者档案 ID。"
          },
          "patient_name": {
            "type": "string",
            "description": "患者姓名。"
          },
          "patient_gender": {
            "type": "string",
            "description": "患者性别名称。"
          },
          "patient_age": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              { "type": "string" }
            ],
            "description": "患者年龄；前端会补充年龄单位。"
          },
          "patient_card_no": {
            "type": "string",
            "description": "患者卡号或病历号。"
          },
          "department_id": { "type": "string" },
          "department_name": { "type": "string" },
          "doctor_id": { "type": "string" },
          "doctor_name": { "type": "string" },
          "visit_no": {
            "type": "string",
            "description": "就诊号。"
          },
          "visit_order": {
            "type": "integer",
            "description": "排队序号。"
          },
          "status": {
            "type": "integer",
            "enum": [ 0, 1, 2 ],
            "description": "0-待就诊，1-就诊中，2-已完成。"
          },
          "status_name": { "type": "string" },
          "register_time": {
            "type": "string",
            "description": "挂号时间，格式 YYYY-MM-DD HH:mm:ss。"
          },
          "expected_visit_time": {
            "type": "string",
            "description": "预计就诊时间。"
          }
        }
      },
      "NurseExecutionItemType": {
        "type": "string",
        "enum": [ "SERVICE", "MEDICATION" ],
        "description": "执行项目类型。"
      },
      "NurseExecutionStatus": {
        "type": "string",
        "enum": [ "PENDING", "COMPLETED", "CANCELLED" ],
        "description": "护士执行状态。"
      },
      "NursePrintDocumentType": {
        "type": "string",
        "enum": [
          "BOTTLE_LABEL",
          "TREATMENT_SHEET",
          "SPECIMEN_BARCODE",
          "PRESCRIPTION",
          "SKIN_TEST_LABEL",
          "NEBULIZATION_LABEL",
          "PROCEDURE_APPLICATION"
        ],
        "description": "打印类型：瓶贴、处置单、采血码、处方单、皮试标签、雾化标签、处置申请单。"
      },
      "NurseExecutionItem": {
        "type": "object",
        "required": [
          "itemId",
          "requestId",
          "requestType",
          "requestTypeName",
          "orderContent",
          "status",
          "statusName",
          "plannedCount",
          "executedCount",
          "version",
          "printTypes"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "description": "执行项目 ID。"
          },
          "requestId": {
            "type": "string",
            "description": "来源医嘱或申请 ID。"
          },
          "requestType": { "$ref": "#/components/schemas/NurseExecutionItemType" },
          "requestTypeName": {
            "type": "string",
            "example": "处置"
          },
          "orderContent": {
            "type": "string",
            "example": "静脉输液"
          },
          "specification": {
            "type": "string",
            "example": "0.9%氯化钠注射液 250ml，静滴"
          },
          "status": { "$ref": "#/components/schemas/NurseExecutionStatus" },
          "statusName": {
            "type": "string",
            "example": "待执行"
          },
          "plannedCount": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "executedCount": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "executorName": {
            "type": "string",
            "nullable": true
          },
          "executedAt": {
            "type": "string",
            "nullable": true,
            "description": "最近执行时间。"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "乐观锁版本。"
          },
          "printTypes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NursePrintDocumentType" }
          }
        }
      },
      "ExecutionItemsResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NurseExecutionItem" }
          }
        }
      },
      "NurseConsumableStatus": {
        "type": "string",
        "enum": [ "PENDING", "DISPENSED" ]
      },
      "NurseConsumableItem": {
        "type": "object",
        "required": [
          "dispenseItemId",
          "materialId",
          "materialName",
          "specification",
          "quantity",
          "unitName",
          "roomName",
          "status",
          "statusName"
        ],
        "properties": {
          "dispenseItemId": { "type": "string" },
          "materialId": { "type": "string" },
          "materialName": {
            "type": "string",
            "example": "一次性使用输液器"
          },
          "specification": {
            "type": "string",
            "example": "带针 0.7mm"
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "example": 1
          },
          "unitName": {
            "type": "string",
            "example": "套"
          },
          "roomName": {
            "type": "string",
            "example": "门诊耗材室"
          },
          "status": { "$ref": "#/components/schemas/NurseConsumableStatus" },
          "statusName": {
            "type": "string",
            "example": "待发放"
          }
        }
      },
      "ConsumableItemsResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NurseConsumableItem" }
          }
        }
      },
      "NurseExecutionCommandItem": {
        "type": "object",
        "required": [ "itemId", "version" ],
        "properties": {
          "itemId": { "type": "string" },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PerformNurseExecutionsRequest": {
        "type": "object",
        "required": [ "encounterId", "items", "idempotencyKey" ],
        "properties": {
          "encounterId": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/NurseExecutionCommandItem" }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "description": "重复请求必须返回相同结果且不得重复执行。"
          }
        }
      },
      "CancelNurseExecutionRequest": {
        "type": "object",
        "required": [ "encounterId", "item", "reason" ],
        "properties": {
          "encounterId": { "type": "string" },
          "item": { "$ref": "#/components/schemas/NurseExecutionCommandItem" },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "NurseExecutionFailure": {
        "type": "object",
        "required": [ "itemId", "code", "message" ],
        "properties": {
          "itemId": { "type": "string" },
          "code": {
            "type": "string",
            "enum": [ "ITEM_NOT_FOUND", "INVALID_STATUS", "VERSION_CONFLICT" ]
          },
          "message": { "type": "string" }
        }
      },
      "NurseExecutionCommandResult": {
        "type": "object",
        "required": [ "successItems", "failedItems" ],
        "properties": {
          "successItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NurseExecutionItem" }
          },
          "failedItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NurseExecutionFailure" }
          }
        }
      },
      "ExecutionCommandResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "操作完成"
          },
          "data": { "$ref": "#/components/schemas/NurseExecutionCommandResult" }
        }
      },
      "NursePrintRequest": {
        "type": "object",
        "required": [ "encounterId", "documentIds", "documentType", "reprint" ],
        "properties": {
          "encounterId": { "type": "string" },
          "documentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "需要打印的执行项目 ID。"
          },
          "documentType": { "$ref": "#/components/schemas/NursePrintDocumentType" },
          "reprint": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "NursePrintResult": {
        "type": "object",
        "required": [ "success", "printer", "message", "documentType", "count" ],
        "properties": {
          "success": { "type": "boolean" },
          "printer": {
            "type": "string",
            "example": "护士站打印机-01"
          },
          "message": {
            "type": "string",
            "example": "打印任务已提交"
          },
          "documentType": { "$ref": "#/components/schemas/NursePrintDocumentType" },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PrintResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "打印任务已提交"
          },
          "data": { "$ref": "#/components/schemas/NursePrintResult" }
        }
      },
      "NurseExecutionRecord": {
        "allOf": [
          { "$ref": "#/components/schemas/NurseExecutionItem" },
          {
            "type": "object",
            "required": [ "encounterId", "visitNo" ],
            "properties": {
              "encounterId": { "type": "string" },
              "visitNo": { "type": "string" }
            }
          }
        ]
      },
      "ExecutionHistoryPage": {
        "type": "object",
        "required": [ "pageIndex", "pageSize", "total", "rows" ],
        "properties": {
          "pageIndex": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NurseExecutionRecord" }
          }
        }
      },
      "ExecutionHistoryResponse": {
        "type": "object",
        "required": [ "code", "message", "data" ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 10000
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": { "$ref": "#/components/schemas/ExecutionHistoryPage" }
        }
      }
    }
  }
}
