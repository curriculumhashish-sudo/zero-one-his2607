# Deployment: requests are proxied by same-origin Nginx.
VITE_API_URL=/api
VITE_API_TIMEOUT=10000
VITE_USE_MOCK=false

# Login and authentication
VITE_LOGIN_API_URL=/login-api
VITE_LOGIN_PROVIDER=
VITE_J1_API_URL=/j1-api
VITE_J1_SYSMGR_API_URL=/j1-sysmgr-api
VITE_CAPTCHA_URL=/captcha
VITE_CAPTCHA_PREFIX=captcha
VITE_AUTH_GUARD_ENABLED=true
VITE_AUTH_SERVER_URL=/j1-login
VITE_CLIENT_ID=project-manager

# Basic data, configuration and system management
VITE_C5_BASICDATA_SERVER_URL=/c5-basicdata-api
VITE_C7_CONFIGURATION_SERVER_URL=/c7-configuration-api
VITE_C6_API_URL=/c6-api
VITE_J4_API_URL=/j4-api

# Scheduling, billing and reporting
VITE_J8_CALENDAR_MOCK=false
VITE_J8_CALENDAR_SERVER_URL=/j8-calendar
VITE_J8_CALENDAR_PRACTITIONER_OPTIONS_PATH=/j8/calendar/listPractitioners
VITE_J8_OUTPATIENT_FEE_MOCK=false
VITE_J8_OUTPATIENT_FEE_SERVER_URL=/j8-outpatient
VITE_J8_SETROSTER_MOCK=false
VITE_J8_SETROSTER_SERVER_URL=/j8-setroster
VITE_J8_CLINICS_MOCK=false
VITE_J8_CLINICS_SERVER_URL=/j8-clinics
VITE_J8_STATISTICS_SERVER_URL=/j8-statdata
VITE_J8_STATISTICS_EXPIRY_PATH=/j8/statdata/expire-warning
VITE_J8_STATISTICS_EXPIRY_GOODS_TYPE=
VITE_REPORT_STATISTICS_PROVIDER=j8
VITE_J6_STATISTICS_SERVER_URL=/j6-report
VITE_J6_OUTPATIENT_FEE_SERVER_URL=/j6-report
VITE_C1_STATISTICS_SERVER_URL=/c1-report
VITE_C1_OUTPATIENT_FEE_SERVER_URL=/c1-report
VITE_C1_CHARGE_SERVER_URL=/c1-charge
VITE_CHARGE_PROVIDER=c1
VITE_C1_ALLOW_LEGACY_REGISTER_SLOT=true
VITE_CHARGE_APP_URL=http://47.96.170.133

# Workstations
VITE_NURSE_STATION_API_MODE=real
VITE_NURSE_STATION_API_URL=/nurse-station-api
VITE_OUTPATIENT_NURSE_STATION_API_MODE=real
VITE_OUTPATIENT_NURSE_STATION_API_URL=/outpatient-nurse-station-api
VITE_INPATIENT_DOCTOR_STATION_API_MODE=real
VITE_INPATIENT_DOCTOR_STATION_API_URL=/inpatient-doctor-station-api
VITE_OUTPATIENT_DOCTOR_STATION_API_MODE=real
VITE_OUTPATIENT_DOCTOR_STATION_API_URL=/api
